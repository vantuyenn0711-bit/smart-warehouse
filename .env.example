# Copy to .env. Generate your own random values; never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://warehouse:replace-password@127.0.0.1:5432/warehouse
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=replace-password
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
DEMO_MODE=true
APP_PORT=8010
LOCAL_POSTGRES_PORT=5432
# Optional seed_demo reads DEMO_PASSWORD or asks securely. Never printed.
# DEMO_PASSWORD=
